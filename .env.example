# ===========================
# KnowPilot - Environment Variables
# ===========================

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://knowpilot:knowpilot_password@db:5432/knowpilot

# Redis
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
TEST_PRINCIPAL_LEGACY_ALLOWLIST=
ACTION_OUTBOX_DELIVERY_ADAPTER=
GUNICORN_WORKERS=2

# Default-off staged rollout flags
CHAT_TURN_IDEMPOTENCY=false
CHAT_STREAM_V2=false
CAPABILITY_NAV=false
DEEP_ANSWER_MODE=false
THINKING_MODE=false
WORKSPACE_CREATION_APPROVAL=false
TEMPLATE_ASSET_COPY_ENABLED=false
WORKSPACE_JOIN_V2=false
WORKSPACE_PERMANENT_DELETE=false
SPACE_CREDENTIAL_PEPPER_VERSION=1
SPACE_CREDENTIAL_PEPPERS={"1":"replace-with-a-separate-random-secret"}
SPACE_INVITATION_ENCRYPTION_KEY=replace-with-an-independent-random-secret
VITE_CAPABILITY_NAV=false
VITE_DEEP_ANSWER_MODE=false
VITE_THINKING_MODE=false
VITE_WORKSPACE_CREATION_APPROVAL=false
VITE_WORKSPACE_JOIN_V2=false
VITE_WORKSPACE_PERMANENT_DELETE=false

# DashScope API (Qwen LLM + Embeddings)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
QWEN_CHAT_MODEL=qwen3.7-Flash
QWEN_EMBEDDING_MODEL=text-embedding-v4

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# RAG Settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media / File Upload
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=50
