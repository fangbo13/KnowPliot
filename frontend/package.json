{
  "name": "ey-onboarding-ai-frontend",
  "private": true,
  "version": "6.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:i18n": "node scripts/check-i18n.cjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "test:bundle-budget": "node --test scripts/check-bundle-budget.node-test.mjs scripts/vite-direct-imports.node-test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "antd": "^5.0.0",
    "axios": "^1.7.0",
    "framer-motion": "^12.42.2",
    "highlight.js": "^11.11.1",
    "i18next": "^23.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^14.0.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.0.0",
    "react-virtuoso": "^4.18.7",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^24.0.0",
    "puppeteer": "^25.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
